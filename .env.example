# Required for AI repository analysis
OPENAI_API_KEY=

# Optional model/base URL overrides
GRADER_LLM_MODEL=gpt-5.6
GRADER_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional token for cloning private student repositories.
# Use a fine-grained read-only token scoped only to required repositories.
STUDENT_REPOS_TOKEN=

# Keep the real grading seed in GitHub Actions Secrets, not in git.
GRADER_HIDDEN_SEED=
