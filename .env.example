# Required for AI repository analysis (Gemini)
GEMINI_API_KEY=

# Gemini is the default provider
GRADER_LLM_PROVIDER=gemini
GRADER_LLM_MODEL=gemini-2.5-flash
GRADER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional token for cloning private student repositories.
# Use a fine-grained read-only token scoped only to required repositories.
STUDENT_REPOS_TOKEN=

# Keep the real grading seed in GitHub Actions Secrets, not in git.
GRADER_HIDDEN_SEED=
